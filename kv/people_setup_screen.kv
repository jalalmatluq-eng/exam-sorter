#:kivy 2.0.0

<PeopleSetupScreen>:
    name: "people_setup_screen"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.94, 0.97, 1.0, 1

        # ═══ شريط علوي كوني ═════════════════════════════════
        MDTopAppBar:
            id: top_bar
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: 1.0, 1.0, 1.0, 0.98
            elevation: 0

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left-circle-outline"
                    theme_icon_color: "Custom"
                    icon_color: 0.02, 0.52, 0.80, 1
                    on_release: root.go_back()

            MDTopAppBarTitle:
                id: top_bar_title
                text: app.ar("بصمة الوجه | CosmoSort")
                theme_text_color: "Custom"
                text_color: 0.08, 0.16, 0.34, 1
                bold: True

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: [dp(14), dp(14), dp(14), dp(28)]
                spacing: dp(12)
                size_hint_y: None
                height: self.minimum_height

                # ─── بطاقة التعريف الكونية ─────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(108)
                    radius: [26, 26, 26, 26]
                    padding: dp(16)
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(14)

                        MDIcon:
                            icon: "face-recognition"
                            theme_icon_color: "Custom"
                            icon_color: 0.02, 0.52, 0.80, 1
                            font_size: "42sp"
                            pos_hint: {"center_y": 0.5}

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(4)
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: header_title
                                text: app.ar("التعرف على صاحب الجهاز")
                                bold: True
                                font_size: "15sp"
                                theme_text_color: "Custom"
                                text_color: 0.08, 0.16, 0.34, 1
                                halign: "right"

                            MDLabel:
                                id: header_subtitle
                                text: app.ar("أضف 1-5 صور واضحة لوجهك لتمييز صورك الخاصة.")
                                font_size: "11sp"
                                theme_text_color: "Custom"
                                text_color: 0.35, 0.45, 0.60, 1
                                halign: "right"

                # ─── بطاقة حالة البصمة ─────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(66)
                    radius: [20, 20, 20, 20]
                    padding: [dp(16), dp(10), dp(16), dp(10)]
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 0.90, 0.95, 1.0, 0.95
                    orientation: "horizontal"
                    spacing: dp(12)

                    MDIcon:
                        id: status_icon
                        icon: "check-decagram"
                        font_size: "28sp"
                        theme_icon_color: "Custom"
                        icon_color: 0.05, 0.65, 0.40, 1
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        id: profile_status_label
                        text: app.ar("بصمة الوجه: مسجلة ومفعلة")
                        bold: True
                        font_size: "13sp"
                        halign: "right"
                        pos_hint: {"center_y": 0.5}
                        theme_text_color: "Custom"
                        text_color: 0.08, 0.16, 0.34, 1

                # ─── عنوان قسم الصور المرجعية ─────────────────
                MDBoxLayout:
                    size_hint_y: None
                    height: dp(28)
                    orientation: "horizontal"

                    MDLabel:
                        id: photos_section_title
                        text: app.ar("صور وجهك المرجعية (1 - 5 صور)")
                        bold: True
                        font_size: "14sp"
                        halign: "right"
                        theme_text_color: "Custom"
                        text_color: 0.08, 0.16, 0.34, 1

                    MDIcon:
                        icon: "image-multiple-outline"
                        font_size: "22sp"
                        size_hint_x: None
                        width: dp(28)
                        theme_icon_color: "Custom"
                        icon_color: 0.48, 0.22, 0.85, 1

                # ─── شبكة الصور المرجعية ───────────────────────
                MDGridLayout:
                    id: samples_grid
                    cols: 3
                    size_hint_y: None
                    height: dp(132)
                    spacing: dp(10)

                # ─── أزرار الإضافة ────────────────────────────
                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(50)

                    MDButton:
                        style: "filled"
                        size_hint_x: 0.5
                        radius: [18, 18, 18, 18]
                        theme_bg_color: "Custom"
                        md_bg_color: 0.48, 0.22, 0.85, 1
                        on_release: root.pick_from_gallery()

                        MDButtonIcon:
                            icon: "image-plus-outline"
                            theme_icon_color: "Custom"
                            icon_color: 1.0, 1.0, 1.0, 1

                        MDButtonText:
                            id: btn_gallery_text
                            text: app.ar("من المعرض")
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            bold: True

                    MDButton:
                        style: "filled"
                        size_hint_x: 0.5
                        radius: [18, 18, 18, 18]
                        theme_bg_color: "Custom"
                        md_bg_color: 0.02, 0.52, 0.80, 1
                        on_release: root.capture_from_camera()

                        MDButtonIcon:
                            icon: "camera-plus-outline"
                            theme_icon_color: "Custom"
                            icon_color: 1.0, 1.0, 1.0, 1

                        MDButtonText:
                            id: btn_camera_text
                            text: app.ar("التقاط صورة")
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1
                            bold: True

                # ─── ضبط دقة التعرف الكوني ──────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(82)
                    radius: [20, 20, 20, 20]
                    padding: [dp(14), dp(8), dp(14), dp(8)]
                    elevation: 0
                    orientation: "vertical"
                    spacing: dp(2)
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(26)

                        MDLabel:
                            id: threshold_val_label
                            text: "68%"
                            bold: True
                            font_size: "13sp"
                            size_hint_x: None
                            width: dp(48)
                            theme_text_color: "Custom"
                            text_color: 0.02, 0.52, 0.80, 1

                        MDLabel:
                            id: threshold_title
                            text: app.ar("عتبة دقة المطابقة (Similarity Threshold):")
                            font_size: "12sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1

                    Slider:
                        id: threshold_slider
                        min: 50
                        max: 90
                        value: 68
                        step: 1
                        size_hint_y: None
                        height: dp(36)
                        on_value: root.on_threshold_change(self.value)

                # ─── زر حفظ وتدريب البصمة ─────────────────────
                MDButton:
                    id: btn_train
                    style: "filled"
                    size_hint_y: None
                    height: dp(54)
                    radius: [20, 20, 20, 20]
                    theme_bg_color: "Custom"
                    md_bg_color: 0.02, 0.52, 0.80, 1
                    on_release: root.train_and_save()

                    MDButtonIcon:
                        icon: "fingerprint"
                        theme_icon_color: "Custom"
                        icon_color: 1.0, 1.0, 1.0, 1

                    MDButtonText:
                        id: btn_train_text
                        text: app.ar("حفظ وتحديث بصمة وجهي")
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                # ─── بطاقة اختبار التعرف ──────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(124)
                    radius: [22, 22, 22, 22]
                    elevation: 0
                    padding: dp(14)
                    orientation: "vertical"
                    spacing: dp(10)
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98

                    MDLabel:
                        id: test_title
                        text: app.ar("تجربة التعرف على أي صورة الآن:")
                        bold: True
                        font_size: "13sp"
                        halign: "right"
                        theme_text_color: "Custom"
                        text_color: 0.08, 0.16, 0.34, 1

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(12)

                        MDButton:
                            style: "outlined"
                            size_hint_x: 0.42
                            radius: [16, 16, 16, 16]
                            theme_bg_color: "Custom"
                            md_bg_color: 0.92, 0.95, 1.0, 0.95
                            on_release: root.test_recognition()

                            MDButtonIcon:
                                icon: "file-find-outline"
                                theme_icon_color: "Custom"
                                icon_color: 0.02, 0.52, 0.80, 1

                            MDButtonText:
                                id: btn_test_text
                                text: app.ar("اختر صورة")
                                theme_text_color: "Custom"
                                text_color: 0.08, 0.16, 0.34, 1
                                bold: True

                        MDLabel:
                            id: test_result_label
                            text: app.ar("اختر صورة لفحصها...")
                            font_size: "12sp"
                            halign: "center"
                            pos_hint: {"center_y": 0.5}
                            theme_text_color: "Custom"
                            text_color: 0.35, 0.45, 0.60, 1
