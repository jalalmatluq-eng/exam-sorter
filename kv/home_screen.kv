#:kivy 2.0.0

<HomeScreen>:
    name: "home_screen"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.976, 0.965, 0.945, 1

        # شريط التطبيق العلوي الحديث بالبيج والعاجي الفاخر
        MDTopAppBar:
            id: top_bar
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: 0.957, 0.937, 0.902, 1
            elevation: 1

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "folder-star-outline"
                    theme_icon_color: "Custom"
                    icon_color: 0.72, 0.42, 0.24, 1

            MDTopAppBarTitle:
                id: top_bar_title
                text: app.ar("منظّم الوسائط الذكي")
                theme_text_color: "Custom"
                text_color: 0.20, 0.16, 0.14, 1
                bold: True

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "refresh"
                    theme_icon_color: "Custom"
                    icon_color: 0.52, 0.40, 0.30, 1
                    on_release: root.refresh_subjects()

                MDActionTopAppBarButton:
                    icon: "cog-outline"
                    theme_icon_color: "Custom"
                    icon_color: 0.52, 0.40, 0.30, 1
                    on_release: root.open_settings_screen()

        # المساحة التفاعلية الرئيسية المتجاوبة لكافة الشاشات
        MDBoxLayout:
            orientation: "vertical"
            padding: [dp(16), dp(12), dp(16), dp(8)]
            spacing: dp(10)

            # بطاقة الإحصائيات الفخمة (Dashboard Card) بلون البيج الرملي الدافئ
            MDCard:
                id: hero_card
                size_hint_y: None
                height: dp(120)
                radius: [20, 20, 20, 20]
                padding: dp(12)
                elevation: 2
                theme_bg_color: "Custom"
                md_bg_color: 0.925, 0.885, 0.825, 1

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(8)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(24)

                        MDLabel:
                            id: hero_title
                            text: app.ar("لوحة الفرز والتحكم الذكي")
                            theme_text_color: "Custom"
                            text_color: 0.22, 0.17, 0.14, 1
                            font_size: "13sp"
                            bold: True
                            halign: "right"
                            valign: "middle"

                        MDIcon:
                            icon: "creation"
                            theme_icon_color: "Custom"
                            icon_color: 0.85, 0.52, 0.15, 1
                            font_size: "18sp"
                            size_hint_x: None
                            width: dp(24)

                    # كبسولات الإحصائيات العاجية
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(10)

                        # كبسولة عدد المجلدات
                        MDCard:
                            radius: [14, 14, 14, 14]
                            padding: [dp(8), dp(4)]
                            elevation: 1
                            theme_bg_color: "Custom"
                            md_bg_color: 1.0, 0.992, 0.980, 0.92

                            MDBoxLayout:
                                orientation: "vertical"
                                pos_hint: {"center_y": 0.5}

                                MDLabel:
                                    id: stats_count
                                    text: app.ar("0 مجلد")
                                    theme_text_color: "Custom"
                                    text_color: 0.72, 0.42, 0.24, 1
                                    bold: True
                                    font_size: "17sp"
                                    halign: "center"

                                MDLabel:
                                    id: stats_title
                                    text: app.ar("المجلدات المنظمة")
                                    theme_text_color: "Custom"
                                    text_color: 0.48, 0.42, 0.38, 1
                                    font_size: "11sp"
                                    halign: "center"

                        # كبسولة إجمالي الملفات
                        MDCard:
                            radius: [14, 14, 14, 14]
                            padding: [dp(8), dp(4)]
                            elevation: 1
                            theme_bg_color: "Custom"
                            md_bg_color: 1.0, 0.992, 0.980, 0.92

                            MDBoxLayout:
                                orientation: "vertical"
                                pos_hint: {"center_y": 0.5}

                                MDLabel:
                                    id: stats_exams_count
                                    text: app.ar("0 ملف")
                                    theme_text_color: "Custom"
                                    text_color: 0.72, 0.42, 0.24, 1
                                    bold: True
                                    font_size: "17sp"
                                    halign: "center"

                                MDLabel:
                                    id: stats_exams_title
                                    text: app.ar("إجمالي الملفات")
                                    theme_text_color: "Custom"
                                    text_color: 0.48, 0.42, 0.38, 1
                                    font_size: "11sp"
                                    halign: "center"

            # شريط الأزرار التفاعلية السريعة (Quick Actions Toolbar)
            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(8)
                size_hint_y: None
                height: dp(42)

                MDButton:
                    style: "outlined"
                    size_hint_x: 0.25
                    radius: [14, 14, 14, 14]
                    theme_bg_color: "Custom"
                    md_bg_color: 1, 0.992, 0.980, 1
                    on_release: root.open_people_setup()

                    MDButtonIcon:
                        icon: "account-box-multiple"
                        theme_icon_color: "Custom"
                        icon_color: 0.72, 0.42, 0.24, 1

                    MDButtonText:
                        id: btn_quick_face_text
                        text: app.ar("بصمتي")
                        theme_text_color: "Custom"
                        text_color: 0.24, 0.18, 0.15, 1
                        font_size: "11sp"
                        bold: True

                MDButton:
                    style: "outlined"
                    size_hint_x: 0.25
                    radius: [14, 14, 14, 14]
                    theme_bg_color: "Custom"
                    md_bg_color: 1, 0.992, 0.980, 1
                    on_release: root.run_instant_scan()

                    MDButtonIcon:
                        icon: "lightning-bolt-outline"
                        theme_icon_color: "Custom"
                        icon_color: 0.85, 0.52, 0.15, 1

                    MDButtonText:
                        id: btn_quick_scan_text
                        text: app.ar("فحص فوري")
                        theme_text_color: "Custom"
                        text_color: 0.24, 0.18, 0.15, 1
                        font_size: "11sp"
                        bold: True

                MDButton:
                    style: "outlined"
                    size_hint_x: 0.25
                    radius: [14, 14, 14, 14]
                    theme_bg_color: "Custom"
                    md_bg_color: 1, 0.992, 0.980, 1
                    on_release: root.open_storage_folder()

                    MDButtonIcon:
                        icon: "folder-open-outline"
                        theme_icon_color: "Custom"
                        icon_color: 0.72, 0.42, 0.24, 1

                    MDButtonText:
                        id: btn_quick_folder_text
                        text: app.ar("المجلد")
                        theme_text_color: "Custom"
                        text_color: 0.24, 0.18, 0.15, 1
                        font_size: "11sp"
                        bold: True

                MDButton:
                    style: "outlined"
                    size_hint_x: 0.25
                    radius: [14, 14, 14, 14]
                    theme_bg_color: "Custom"
                    md_bg_color: 1, 0.992, 0.980, 1
                    on_release: root.clean_empty_folders()

                    MDButtonIcon:
                        icon: "broom"
                        theme_icon_color: "Custom"
                        icon_color: 0.72, 0.42, 0.24, 1

                    MDButtonText:
                        id: btn_quick_clean_text
                        text: app.ar("تنظيف")
                        theme_text_color: "Custom"
                        text_color: 0.24, 0.18, 0.15, 1
                        font_size: "11sp"
                        bold: True

            # شريط البحث السريع عن المجلدات والمواد
            MDCard:
                size_hint_y: None
                height: dp(46)
                radius: [16, 16, 16, 16]
                padding: [dp(12), dp(2), dp(12), dp(2)]
                elevation: 1
                theme_bg_color: "Custom"
                md_bg_color: 1, 0.992, 0.980, 1
                orientation: "horizontal"
                spacing: dp(8)

                MDIcon:
                    icon: "magnify"
                    pos_hint: {"center_y": 0.5}
                    theme_icon_color: "Custom"
                    icon_color: 0.72, 0.44, 0.26, 1
                    size_hint_x: None
                    width: dp(24)

                TextInput:
                    id: search_input
                    hint_text: app.ar("ابحث عن مجلد أو مادة...")
                    multiline: False
                    background_color: 0, 0, 0, 0
                    foreground_color: 0.20, 0.16, 0.14, 1
                    font_size: "13sp"
                    cursor_color: 0.72, 0.44, 0.26, 1
                    pos_hint: {"center_y": 0.5}
                    on_text: root.filter_subjects(self.text)

            # شريط عنوان قسم المواد والمجلدات
            MDBoxLayout:
                size_hint_y: None
                height: dp(24)
                orientation: "horizontal"
                padding: [dp(4), 0]

                MDLabel:
                    id: section_title
                    text: app.ar("الأقسام والمجلدات المنظمة")
                    bold: True
                    font_size: "14sp"
                    halign: "right"
                    theme_text_color: "Custom"
                    text_color: 0.22, 0.17, 0.14, 1

                MDIcon:
                    icon: "folder-star-outline"
                    theme_icon_color: "Custom"
                    icon_color: 0.72, 0.44, 0.26, 1
                    size_hint_x: None
                    width: dp(22)

            # الحاوية المركزية: قائمة المواد أو كرت الحالة الفارغة
            FloatLayout:
                # تصميم حالة عدم وجود مواد (Empty State جذاب وفخم)
                MDCard:
                    id: empty_state
                    orientation: "vertical"
                    size_hint: 0.92, None
                    height: dp(250)
                    pos_hint: {"center_x": 0.5, "center_y": 0.52}
                    radius: [24, 24, 24, 24]
                    elevation: 1
                    theme_bg_color: "Custom"
                    md_bg_color: 1, 0.992, 0.980, 1
                    padding: dp(20)
                    spacing: dp(12)
                    opacity: 0

                    MDIcon:
                        icon: "image-filter-frames"
                        font_size: "50sp"
                        halign: "center"
                        theme_icon_color: "Custom"
                        icon_color: 0.72, 0.42, 0.24, 0.85

                    MDLabel:
                        id: empty_state_label
                        text: app.ar("لا توجد ملفات مصنفة بعد")
                        halign: "center"
                        bold: True
                        font_size: "16sp"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.16, 0.14, 1

                    MDLabel:
                        id: empty_state_sub
                        text: app.ar("التقط ورقة امتحان، أو فعّل المراقبة التلقائية لفرز صورك وفيديوهاتك فورياً.")
                        halign: "center"
                        font_size: "12sp"
                        theme_text_color: "Custom"
                        text_color: 0.52, 0.46, 0.42, 1

                    MDButton:
                        style: "filled"
                        pos_hint: {"center_x": 0.5}
                        theme_bg_color: "Custom"
                        md_bg_color: 0.72, 0.42, 0.24, 1
                        on_release: root.go_to_capture()

                        MDButtonIcon:
                            icon: "camera-plus"
                            theme_icon_color: "Custom"
                            icon_color: 1, 1, 1, 1

                        MDButtonText:
                            text: app.ar("تصوير ورقة جديدة")
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                # قائمة المواد القابلة للتمرير
                ScrollView:
                    id: scroll_view
                    do_scroll_x: False

                    MDList:
                        id: subjects_list
                        spacing: dp(10)
                        padding: [0, dp(4), 0, dp(88)]

    # الزر العائم المميز لإضافة ورقة اختبار بتنسيق التراكوتا والكراميل الدافئ
    MDFabButton:
        id: fab_add
        icon: "camera"
        style: "standard"
        theme_bg_color: "Custom"
        md_bg_color: 0.76, 0.44, 0.24, 1
        theme_icon_color: "Custom"
        icon_color: 1, 1, 1, 1
        pos_hint: {"center_x": 0.86, "center_y": 0.08}
        elevation: 4
        on_release: root.go_to_capture()
