#:kivy 2.0.0

<IntroScreen>:
    name: "intro_screen"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.93, 0.96, 1.0, 1.0

        FloatLayout:
            id: main_intro_layout

            # ─── حلقة المدار الكوني الهادئة (بطاقة حلقية ثابتة — آمنة من SIGSEGV) ──
            # ملاحظة: تم استبدال canvas.before مع Line/circle بحل آمن
            # لأن رسم Canvas الديناميكي يسبب SIGSEGV على GPU Adreno

            # ─── حاوية العناصر المدارية (الصور والفيديوهات والملفات) ─
            FloatLayout:
                id: orbit_container
                pos_hint: {"center_x": 0.5, "center_y": 0.55}

            # ─── الشكل الكوني البارز في المركز (حجم ثابت — بدون ربط ديناميكي بـ VBO) ──
            MDCard:
                id: central_cosmos
                size_hint: None, None
                size: dp(96), dp(96)
                pos_hint: {"center_x": 0.5, "center_y": 0.55}
                radius: [dp(48), dp(48), dp(48), dp(48)]
                elevation: 0
                theme_bg_color: "Custom"
                md_bg_color: 0.02, 0.55, 0.88, 1

                MDBoxLayout:
                    orientation: "vertical"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    MDIcon:
                        icon: "orbit"
                        font_size: "48sp"
                        halign: "center"
                        theme_icon_color: "Custom"
                        icon_color: 1.0, 1.0, 1.0, 1

            # ─── نصوص الهوية والتعريف المعبر تحت الكون ──────
            MDBoxLayout:
                orientation: "vertical"
                size_hint_x: 0.9
                size_hint_y: None
                height: dp(120)
                pos_hint: {"center_x": 0.5, "center_y": 0.22}
                spacing: dp(8)
                opacity: root.text_alpha

                MDLabel:
                    id: app_title
                    text: app.ar("Rateb - رتّب | المُنظّم الذكي")
                    font_size: "26sp"
                    bold: True
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.08, 0.16, 0.34, 1

                MDLabel:
                    id: app_tagline
                    text: app.ar("دليلك الأذكى والأسرع لتنظيم وترتيب وسائطك وملفاتك تلقائياً")
                    font_size: "13sp"
                    bold: True
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.25, 0.40, 0.58, 1

                MDLabel:
                    text: app.ar("جاري الدخول إلى فضاء الملفات... (انقر للتخطي)")
                    font_size: "10sp"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.02, 0.55, 0.85, 0.75
