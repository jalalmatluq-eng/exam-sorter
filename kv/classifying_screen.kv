#:kivy 2.0.0

<ClassifyingScreen>:
    name: "classifying_screen"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.976, 0.965, 0.945, 1

        # شريط علوي أنيق بلون البيج والعاجي الفاخر
        MDTopAppBar:
            id: top_bar
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: 0.957, 0.937, 0.902, 1
            elevation: 1

            MDTopAppBarTitle:
                id: top_bar_title
                text: "جاري تحليل الورقة"
                theme_text_color: "Custom"
                text_color: 0.20, 0.16, 0.14, 1
                bold: True
                pos_hint: {"center_x": 0.5}

        MDBoxLayout:
            orientation: "vertical"
            padding: [dp(24), dp(32), dp(24), dp(24)]
            spacing: dp(24)

            Widget:
                size_hint_y: 0.1

            # بطاقة الذكاء الاصطناعي الرئيسية
            MDCard:
                size_hint: 0.92, None
                height: dp(380)
                pos_hint: {"center_x": 0.5}
                radius: [28, 28, 28, 28]
                elevation: 2
                padding: dp(28)
                orientation: "vertical"
                spacing: dp(20)
                theme_bg_color: "Custom"
                md_bg_color: 1, 0.992, 0.980, 1

                # شارة الذكاء الاصطناعي بلون الكراميل الرملي
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint: None, None
                    size: dp(180), dp(36)
                    pos_hint: {"center_x": 0.5}
                    padding: [dp(12), dp(4), dp(12), dp(4)]
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: 0.935, 0.895, 0.835, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [18, 18, 18, 18]

                    MDIcon:
                        icon: "auto-fix"
                        font_size: "18sp"
                        pos_hint: {"center_y": 0.5}
                        theme_icon_color: "Custom"
                        icon_color: 0.72, 0.42, 0.24, 1

                    MDLabel:
                        id: ai_badge_label
                        text: "Claude AI Vision"
                        font_size: "12sp"
                        bold: True
                        halign: "center"
                        pos_hint: {"center_y": 0.5}
                        theme_text_color: "Custom"
                        text_color: 0.72, 0.42, 0.24, 1

                Widget:
                    size_hint_y: 0.05

                # مؤشر التحميل الدوار بتنسيق التراكوتا والكراميل الدافئ
                MDCircularProgressIndicator:
                    id: spinner
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                    active: True
                    color: 0.72, 0.42, 0.24, 1

                Widget:
                    size_hint_y: 0.05

                MDLabel:
                    id: title_label
                    text: "جاري تحليل ورقة الاختبار..."
                    bold: True
                    font_size: "18sp"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.20, 0.16, 0.14, 1

                MDLabel:
                    id: status_label
                    text: "قراءة الترويسة واستخراج اسم المادة عبر نموذج الذكاء الاصطناعي المتقدم"
                    font_size: "13sp"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.52, 0.46, 0.42, 1

                # خطوات المعالجة المرئية
                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(8)
                    size_hint_y: None
                    height: dp(60)

                    MDLabel:
                        id: step1_label
                        text: "✓ فحص الصورة واستخراج النصوص"
                        font_size: "11sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.20, 0.65, 0.35, 1

                    MDLabel:
                        id: step2_label
                        text: "• تحديد اسم المادة والمقرر الدراسي..."
                        font_size: "11sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.72, 0.42, 0.24, 1

            Widget:
                size_hint_y: 0.15

            # زر إلغاء والعودة
            MDButton:
                id: btn_cancel
                style: "outlined"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.6
                radius: [14, 14, 14, 14]
                theme_bg_color: "Custom"
                md_bg_color: 1, 0.992, 0.980, 1
                on_release: root.cancel_classification()

                MDButtonIcon:
                    icon: "close-circle-outline"
                    theme_icon_color: "Custom"
                    icon_color: 0.52, 0.46, 0.42, 1

                MDButtonText:
                    id: text_cancel
                    text: "إلغاء والعودة"
                    theme_text_color: "Custom"
                    text_color: 0.52, 0.46, 0.42, 1
                    bold: True

            Widget:
                size_hint_y: 0.1
