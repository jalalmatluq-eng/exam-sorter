#:kivy 2.0.0

<SettingsScreen>:
    name: "settings_screen"

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 0.94, 0.97, 1.0, 1

        # ═══ شريط علوي كوني ══════════════════════════════════
        MDTopAppBar:
            id: top_bar
            type: "small"
            theme_bg_color: "Custom"
            md_bg_color: 1.0, 1.0, 1.0, 0.98
            elevation: 0

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "arrow-left-circle-outline"
                    theme_icon_color: "Custom"
                    icon_color: 0.02, 0.52, 0.80, 1
                    on_release: root.go_back()

            MDTopAppBarTitle:
                id: top_bar_title
                text: app.ar("الإعدادات | رتّب")
                theme_text_color: "Custom"
                text_color: 0.08, 0.16, 0.34, 1
                bold: True

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: [dp(14), dp(14), dp(14), dp(28)]
                spacing: dp(12)
                size_hint_y: None
                height: self.minimum_height

                # ──────────────────────────────────────────────
                # 1. مصدر الفحص
                # ──────────────────────────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(178)
                    radius: [24, 24, 24, 24]
                    padding: dp(14)
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "vertical"
                    spacing: dp(8)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(28)

                        MDLabel:
                            id: storage_source_title
                            text: app.ar("مصدر الفحص وسحب الملفات")
                            bold: True
                            font_size: "14sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1

                        MDIcon:
                            icon: "folder-search-outline"
                            font_size: "26sp"
                            size_hint_x: None
                            width: dp(30)
                            theme_icon_color: "Custom"
                            icon_color: 0.02, 0.52, 0.80, 1

                    MDLabel:
                        id: storage_source_desc_label
                        text: app.ar("حدد الذاكرة المراد سحب وسائطها")
                        font_size: "11sp"
                        shorten: True
                        shorten_from: "left"
                        halign: "right"
                        size_hint_y: None
                        height: dp(20)
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.45, 0.60, 1

                    # أزرار المصدر
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(6)
                        size_hint_y: None
                        height: dp(44)

                        MDButton:
                            id: btn_src_internal
                            style: "filled"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.02, 0.52, 0.80, 1
                            size_hint_x: 0.33
                            radius: [16, 16, 16, 16]
                            on_release: root.select_storage_source("internal")

                            MDButtonIcon:
                                id: icon_src_internal
                                icon: "cellphone-check"
                                theme_icon_color: "Custom"
                                icon_color: 1, 1, 1, 1

                            MDButtonText:
                                id: text_src_internal
                                text: app.ar("الداخلية")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                font_size: "11sp"

                        MDButton:
                            id: btn_src_sdcard
                            style: "outlined"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.92, 0.95, 1.0, 0.95
                            size_hint_x: 0.33
                            radius: [16, 16, 16, 16]
                            on_release: root.select_storage_source("sdcard")

                            MDButtonIcon:
                                id: icon_src_sdcard
                                icon: "micro-sd"
                                theme_icon_color: "Custom"
                                icon_color: 0.48, 0.22, 0.85, 1

                            MDButtonText:
                                id: text_src_sdcard
                                text: app.ar("كرت SD")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.35, 0.45, 0.60, 1
                                font_size: "11sp"

                        MDButton:
                            id: btn_src_both
                            style: "outlined"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.92, 0.95, 1.0, 0.95
                            size_hint_x: 0.34
                            radius: [16, 16, 16, 16]
                            on_release: root.select_storage_source("both")

                            MDButtonIcon:
                                id: icon_src_both
                                icon: "database-outline"
                                theme_icon_color: "Custom"
                                icon_color: 0.48, 0.22, 0.85, 1

                            MDButtonText:
                                id: text_src_both
                                text: app.ar("كلاهما")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.35, 0.45, 0.60, 1
                                font_size: "11sp"

                # ──────────────────────────────────────────────
                # 2. وجهة الحفظ
                # ──────────────────────────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(180)
                    radius: [24, 24, 24, 24]
                    padding: dp(14)
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "vertical"
                    spacing: dp(8)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(28)

                        MDLabel:
                            id: storage_dest_title
                            text: app.ar("وجهة حفظ الملفات المنظمة")
                            bold: True
                            font_size: "14sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1

                        MDIcon:
                            icon: "folder-arrow-down-outline"
                            font_size: "26sp"
                            size_hint_x: None
                            width: dp(30)
                            theme_icon_color: "Custom"
                            icon_color: 0.02, 0.52, 0.80, 1

                    MDLabel:
                        id: storage_current_path_label
                        text: app.ar("المسار النشط: ...")
                        font_size: "11sp"
                        shorten: True
                        shorten_from: "left"
                        halign: "right"
                        size_hint_y: None
                        height: dp(20)
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.45, 0.60, 1

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(44)

                        MDButton:
                            id: btn_dest_internal
                            style: "filled"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.02, 0.52, 0.80, 1
                            size_hint_x: 0.5
                            radius: [16, 16, 16, 16]
                            on_release: root.select_storage_destination("internal")

                            MDButtonIcon:
                                id: icon_dest_internal
                                icon: "cellphone-check"
                                theme_icon_color: "Custom"
                                icon_color: 1, 1, 1, 1

                            MDButtonText:
                                id: text_dest_internal
                                text: app.ar("الذاكرة الداخلية")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                font_size: "11sp"

                        MDButton:
                            id: btn_dest_sdcard
                            style: "outlined"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.92, 0.95, 1.0, 0.95
                            size_hint_x: 0.5
                            radius: [16, 16, 16, 16]
                            on_release: root.select_storage_destination("sdcard")

                            MDButtonIcon:
                                id: icon_dest_sdcard
                                icon: "micro-sd"
                                theme_icon_color: "Custom"
                                icon_color: 0.02, 0.52, 0.80, 1

                            MDButtonText:
                                id: text_dest_sdcard
                                text: app.ar("كرت SD الخارجي")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.35, 0.45, 0.60, 1
                                font_size: "11sp"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(4)
                        size_hint_y: None
                        height: dp(32)

                        MDButton:
                            style: "text"
                            size_hint_x: 0.5
                            on_release: root.open_current_media_folder()

                            MDButtonIcon:
                                icon: "folder-open-outline"
                                theme_icon_color: "Custom"
                                icon_color: 0.02, 0.52, 0.80, 1

                            MDButtonText:
                                id: text_open_folder_btn
                                text: app.ar("فتح المجلد المنظم")
                                font_size: "10sp"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.02, 0.52, 0.80, 1

                        MDButton:
                            style: "text"
                            size_hint_x: 0.5
                            on_release: root.pick_saf_sdcard_folder()

                            MDButtonIcon:
                                icon: "folder-key-network-outline"
                                theme_icon_color: "Custom"
                                icon_color: 0.486, 0.302, 0.988, 1

                            MDButtonText:
                                text: app.ar("إذن مجلد SD (SAF)")
                                font_size: "10sp"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.486, 0.302, 0.988, 1

                # ──────────────────────────────────────────────
                # 3. صلاحية الوصول
                # ──────────────────────────────────────────────
                MDCard:
                    id: permission_card
                    size_hint_y: None
                    height: dp(130)
                    radius: [24, 24, 24, 24]
                    padding: dp(14)
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "vertical"
                    spacing: dp(6)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(26)

                        MDLabel:
                            id: perm_title
                            text: app.ar("صلاحية الوصول الشامل")
                            bold: True
                            font_size: "13sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1

                        MDIcon:
                            id: perm_icon
                            icon: "shield-check-outline"
                            font_size: "24sp"
                            size_hint_x: None
                            width: dp(28)
                            theme_icon_color: "Custom"
                            icon_color: 0.05, 0.65, 0.40, 1

                    MDLabel:
                        id: perm_desc_label
                        text: app.ar("الحالة: جاري التحقق...")
                        font_size: "11sp"
                        halign: "right"
                        size_hint_y: None
                        height: dp(20)
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.45, 0.60, 1

                    MDButton:
                        id: btn_request_permission
                        style: "filled"
                        size_hint_y: None
                        height: dp(40)
                        radius: [16, 16, 16, 16]
                        theme_bg_color: "Custom"
                        md_bg_color: 0.05, 0.65, 0.40, 1
                        on_release: root.request_all_files_permission()

                        MDButtonIcon:
                            icon: "shield-account-outline"
                            theme_icon_color: "Custom"
                            icon_color: 1, 1, 1, 1

                        MDButtonText:
                            id: btn_permission_text
                            text: app.ar("منح الصلاحية من إعدادات الهاتف")
                            font_size: "11sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                # ──────────────────────────────────────────────
                # 4. نمط النسخ/النقل
                # ──────────────────────────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(148)
                    radius: [24, 24, 24, 24]
                    padding: dp(14)
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "vertical"
                    spacing: dp(8)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(26)

                        MDLabel:
                            id: mode_card_title
                            text: app.ar("طريقة فرز الملفات")
                            bold: True
                            font_size: "13sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1

                        MDIcon:
                            icon: "arrow-decision-outline"
                            font_size: "24sp"
                            size_hint_x: None
                            width: dp(28)
                            theme_icon_color: "Custom"
                            icon_color: 0.85, 0.55, 0.05, 1

                    MDLabel:
                        id: mode_desc_label
                        text: app.ar("نسخ آمن (الأصل يبقى) أو نقل كامل (توفير مساحة)")
                        font_size: "11sp"
                        halign: "right"
                        size_hint_y: None
                        height: dp(20)
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.45, 0.60, 1

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(44)

                        MDButton:
                            id: btn_mode_copy
                            style: "filled"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.02, 0.52, 0.80, 1
                            size_hint_x: 0.5
                            radius: [16, 16, 16, 16]
                            on_release: root.select_operation_mode("copy")

                            MDButtonIcon:
                                id: icon_mode_copy
                                icon: "content-copy"
                                theme_icon_color: "Custom"
                                icon_color: 1, 1, 1, 1

                            MDButtonText:
                                id: text_mode_copy
                                text: app.ar("نسخ آمن")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                font_size: "11sp"

                        MDButton:
                            id: btn_mode_move
                            style: "outlined"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.92, 0.95, 1.0, 0.95
                            size_hint_x: 0.5
                            radius: [16, 16, 16, 16]
                            on_release: root.select_operation_mode("move")

                            MDButtonIcon:
                                id: icon_mode_move
                                icon: "file-move-outline"
                                theme_icon_color: "Custom"
                                icon_color: 0.48, 0.22, 0.85, 1

                            MDButtonText:
                                id: text_mode_move
                                text: app.ar("نقل كامل")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.35, 0.45, 0.60, 1
                                font_size: "11sp"

                # ──────────────────────────────────────────────
                # 5. الفرز الشامل
                # ──────────────────────────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(192)
                    radius: [24, 24, 24, 24]
                    padding: dp(16)
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "vertical"
                    spacing: dp(8)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(26)

                        MDLabel:
                            id: continuous_scan_title
                            text: app.ar("الفرز الشامل لجميع الوسائط")
                            bold: True
                            font_size: "14sp"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1
                            halign: "right"

                        MDIcon:
                            icon: "infinity"
                            theme_icon_color: "Custom"
                            icon_color: 0.85, 0.55, 0.05, 1
                            font_size: "26sp"
                            size_hint_x: None
                            width: dp(30)

                    MDLabel:
                        id: continuous_progress_label
                        text: app.ar("فرز مستمر لكافة الوسائط حتى اكتمال 100%")
                        font_size: "11sp"
                        halign: "right"
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.45, 0.60, 1
                        size_hint_y: None
                        height: dp(22)

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(44)

                        MDButton:
                            id: btn_continuous_scan
                            style: "filled"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.85, 0.55, 0.05, 1
                            size_hint_x: 0.65
                            radius: [16, 16, 16, 16]
                            on_release: root.toggle_continuous_scan()

                            MDButtonIcon:
                                id: icon_continuous_scan
                                icon: "play-circle-outline"
                                theme_icon_color: "Custom"
                                icon_color: 1.0, 1.0, 1.0, 1

                            MDButtonText:
                                id: text_continuous_scan
                                text: app.ar("فرز شامل حتى النهاية")
                                bold: True
                                font_size: "11sp"
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                        MDButton:
                            id: btn_single_batch_scan
                            style: "outlined"
                            theme_bg_color: "Custom"
                            md_bg_color: 0.92, 0.95, 1.0, 0.95
                            size_hint_x: 0.35
                            radius: [16, 16, 16, 16]
                            on_release: root.start_manual_scan()

                            MDButtonText:
                                id: text_single_batch_scan
                                text: app.ar("دفعة 40")
                                bold: True
                                font_size: "11sp"
                                theme_text_color: "Custom"
                                text_color: 0.35, 0.45, 0.60, 1

                    MDButton:
                        style: "text"
                        size_hint_y: None
                        height: dp(34)
                        pos_hint: {"right": 1}
                        on_release: root.confirm_clear_cache()

                        MDButtonIcon:
                            icon: "refresh-auto"
                            theme_icon_color: "Custom"
                            icon_color: 0.85, 0.20, 0.30, 1

                        MDButtonText:
                            id: text_clear_cache_btn
                            text: app.ar("♻️ إعادة فحص جميع الوسائط")
                            font_size: "12sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.85, 0.20, 0.30, 1

                # ──────────────────────────────────────────────
                # 6. خدمة المراقبة
                # ──────────────────────────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(102)
                    radius: [24, 24, 24, 24]
                    padding: dp(16)
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "horizontal"
                    spacing: dp(12)

                    MDIcon:
                        id: service_icon
                        icon: "satellite-variant"
                        font_size: "34sp"
                        pos_hint: {"center_y": 0.5}
                        theme_icon_color: "Custom"
                        icon_color: 0.05, 0.65, 0.40, 1

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(4)
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: service_title
                            text: app.ar("خدمة المراقبة التلقائية")
                            bold: True
                            font_size: "14sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1

                        MDLabel:
                            id: service_desc
                            text: app.ar("فرز أي ملف جديد فور التقاطه أو تنزيله")
                            font_size: "11sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.35, 0.45, 0.60, 1

                    MDButton:
                        id: btn_service_toggle
                        style: "filled"
                        size_hint: None, None
                        size: dp(92), dp(42)
                        radius: [16, 16, 16, 16]
                        pos_hint: {"center_y": 0.5}
                        theme_bg_color: "Custom"
                        md_bg_color: 0.05, 0.65, 0.40, 1
                        on_release: root.toggle_service()

                        MDButtonText:
                            id: text_service_toggle
                            text: app.ar("تعمل")
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1

                # ──────────────────────────────────────────────
                # 7. أدوات التخزين الذكية وشاشة البداية
                # ──────────────────────────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(148)
                    radius: [24, 24, 24, 24]
                    padding: [dp(16), dp(12), dp(16), dp(12)]
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "vertical"
                    spacing: dp(10)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(26)

                        MDLabel:
                            text: app.ar("أدوات التخزين وشاشة البداية")
                            bold: True
                            font_size: "13sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1

                        MDIcon:
                            icon: "auto-fix"
                            font_size: "22sp"
                            size_hint_x: None
                            width: dp(26)
                            theme_icon_color: "Custom"
                            icon_color: 0.02, 0.52, 0.85, 1

                    # أزرار تنظيف المكرر والإحصائيات
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(40)

                        MDButton:
                            style: "filled"
                            size_hint_x: 0.5
                            radius: [14, 14, 14, 14]
                            theme_bg_color: "Custom"
                            md_bg_color: 0.02, 0.52, 0.80, 1
                            on_release: root.show_storage_stats()

                            MDButtonIcon:
                                icon: "chart-pie"
                                theme_icon_color: "Custom"
                                icon_color: 1, 1, 1, 1

                            MDButtonText:
                                text: app.ar("المساحات")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                font_size: "11sp"

                        MDButton:
                            style: "filled"
                            size_hint_x: 0.5
                            radius: [14, 14, 14, 14]
                            theme_bg_color: "Custom"
                            md_bg_color: 0.85, 0.35, 0.20, 1
                            on_release: root.find_duplicates_action()

                            MDButtonIcon:
                                icon: "broom"
                                theme_icon_color: "Custom"
                                icon_color: 1, 1, 1, 1

                            MDButtonText:
                                text: app.ar("تنظيف المكرر")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                                font_size: "11sp"

                    # أزرار شاشة البداية الكونية
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(40)

                        MDButton:
                            id: btn_replay_intro
                            style: "outlined"
                            size_hint_x: 0.45
                            radius: [14, 14, 14, 14]
                            theme_bg_color: "Custom"
                            md_bg_color: 0.94, 0.92, 1.0, 0.95
                            on_release: root.replay_intro()

                            MDButtonIcon:
                                icon: "orbit"
                                theme_icon_color: "Custom"
                                icon_color: 0.50, 0.22, 0.85, 1

                            MDButtonText:
                                text: app.ar("عرض البداية")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.50, 0.22, 0.85, 1
                                font_size: "10sp"

                        MDButton:
                            id: btn_skip_intro
                            style: "outlined"
                            size_hint_x: 0.55
                            radius: [14, 14, 14, 14]
                            theme_bg_color: "Custom"
                            md_bg_color: 0.92, 0.95, 1.0, 0.95
                            on_release: root.toggle_skip_intro()

                            MDButtonIcon:
                                id: icon_skip_intro
                                icon: "skip-next-circle-outline"
                                theme_icon_color: "Custom"
                                icon_color: 0.02, 0.52, 0.80, 1

                            MDButtonText:
                                id: text_skip_intro
                                text: app.ar("تخطي البداية: معطل")
                                bold: True
                                theme_text_color: "Custom"
                                text_color: 0.25, 0.40, 0.58, 1
                                font_size: "10sp"

                # ──────────────────────────────────────────────
                # 8. بصمة الوجه
                # ──────────────────────────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(90)
                    radius: [24, 24, 24, 24]
                    padding: [dp(16), dp(10), dp(16), dp(10)]
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "horizontal"
                    spacing: dp(12)

                    MDIcon:
                        icon: "face-recognition"
                        font_size: "30sp"
                        pos_hint: {"center_y": 0.5}
                        theme_icon_color: "Custom"
                        icon_color: 0.48, 0.22, 0.85, 1

                    MDBoxLayout:
                        orientation: "vertical"
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: face_card_title
                            text: app.ar("بصمة وجهي وصوري الخاصة")
                            bold: True
                            font_size: "13sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1

                        MDLabel:
                            id: face_card_status
                            text: app.ar("جاهزة للتعرف وتمييز صورك")
                            font_size: "11sp"
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: 0.35, 0.45, 0.60, 1

                    MDButton:
                        style: "outlined"
                        size_hint: None, None
                        size: dp(102), dp(40)
                        radius: [16, 16, 16, 16]
                        pos_hint: {"center_y": 0.5}
                        theme_bg_color: "Custom"
                        md_bg_color: 0.92, 0.95, 1.0, 0.95
                        on_release: root.open_people_setup()

                        MDButtonText:
                            id: btn_edit_face_text
                            text: app.ar("تعديل البصمة")
                            theme_text_color: "Custom"
                            text_color: 0.48, 0.22, 0.85, 1

                # ──────────────────────────────────────────────
                # 8. سجل التشخيص والدعم الفني
                # ──────────────────────────────────────────────
                MDCard:
                    size_hint_y: None
                    height: dp(124)
                    radius: [24, 24, 24, 24]
                    padding: dp(14)
                    elevation: 0
                    theme_bg_color: "Custom"
                    md_bg_color: 1.0, 1.0, 1.0, 0.98
                    orientation: "vertical"
                    spacing: dp(6)

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: dp(26)

                        MDLabel:
                            id: debug_log_title
                            text: app.ar("سجل التشخيص واستكشاف الأخطاء")
                            bold: True
                            font_size: "14sp"
                            theme_text_color: "Custom"
                            text_color: 0.08, 0.16, 0.34, 1
                            halign: "right"

                        MDIcon:
                            icon: "file-document-outline"
                            theme_icon_color: "Custom"
                            icon_color: 0.02, 0.52, 0.80, 1
                            font_size: "24sp"
                            size_hint_x: None
                            width: dp(28)

                    MDLabel:
                        id: debug_log_desc
                        text: app.ar("تصدير سجل cosmosort_debug.log إلى مجلد Downloads")
                        font_size: "11sp"
                        halign: "right"
                        theme_text_color: "Custom"
                        text_color: 0.35, 0.45, 0.60, 1
                        size_hint_y: None
                        height: dp(20)

                    MDButton:
                        id: btn_export_log
                        style: "outlined"
                        theme_bg_color: "Custom"
                        md_bg_color: 0.92, 0.95, 1.0, 0.95
                        size_hint_y: None
                        height: dp(38)
                        radius: [14, 14, 14, 14]
                        on_release: root.export_diagnostic_log()

                        MDButtonIcon:
                            icon: "share-variant-outline"
                            theme_icon_color: "Custom"
                            icon_color: 0.02, 0.52, 0.80, 1

                        MDButtonText:
                            id: text_export_log
                            text: app.ar("تصدير سجل التشخيص (Download)")
                            bold: True
                            font_size: "11sp"
                            theme_text_color: "Custom"
                            text_color: 0.02, 0.52, 0.80, 1

                # ──────────────────────────────────────────────
                # 9. سجل العمليات
                # ──────────────────────────────────────────────
                MDBoxLayout:
                    size_hint_y: None
                    height: dp(30)
                    orientation: "horizontal"

                    MDButton:
                        style: "text"
                        size_hint_y: 1
                        on_release: root.refresh_history()

                        MDButtonIcon:
                            icon: "refresh-circle"
                            theme_icon_color: "Custom"
                            icon_color: 0.02, 0.52, 0.80, 1

                        MDButtonText:
                            id: refresh_history_text
                            text: app.ar("تحديث")
                            theme_text_color: "Custom"
                            text_color: 0.02, 0.52, 0.80, 1

                    MDButton:
                        style: "text"
                        size_hint_y: 1
                        on_release: root.undo_all_records()

                        MDButtonIcon:
                            icon: "undo-variant"
                            theme_icon_color: "Custom"
                            icon_color: 0.85, 0.20, 0.30, 1

                        MDButtonText:
                            id: undo_all_text
                            text: app.ar("تراجع عن الكل")
                            theme_text_color: "Custom"
                            text_color: 0.85, 0.20, 0.30, 1

                    Widget:

                    MDLabel:
                        id: history_section_title
                        text: app.ar("سجل عمليات النقل")
                        bold: True
                        font_size: "13sp"
                        halign: "right"
                        theme_text_color: "Custom"
                        text_color: 0.08, 0.16, 0.34, 1

                    MDIcon:
                        icon: "timeline-clock-outline"
                        font_size: "22sp"
                        size_hint_x: None
                        width: dp(26)
                        theme_icon_color: "Custom"
                        icon_color: 0.48, 0.22, 0.85, 1

                # قائمة سجل العمليات
                MDList:
                    id: history_list
                    spacing: dp(8)
