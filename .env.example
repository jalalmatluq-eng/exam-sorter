# ==============================================================================
# ملف إعدادات تطبيق مصنف صور الاختبارات (Exam Sorter)
# ==============================================================================
# قم بنسخ هذا الملف وتسميته بـ .env ثم ضع مفتاحك الخاص:
# copy .env.example .env
# ==============================================================================

# مفتاح Anthropic Claude API (اللازم لتحليل صور الاختبارات وتحديد اسم المادة تلقائياً)
# يمكنك الحصول على المفتاح من خلال: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# نموذج الذكاء الاصطناعي الافتراضي (يمكن ترقيته أو تغييره)
CLAUDE_MODEL=claude-3-haiku-20240307
